# =============================================================================
# Copy to: migration/.env  (do NOT commit real secrets — keep .env local only)
# =============================================================================

# --- PHP-style app (optional; parity / legacy asset URLs) ---
APP_NAME=Mobile Backcase Store
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata

# --- MongoDB (required for Node API — no MySQL in Node) ---
MONGODB_URI=mongodb://localhost:27017/backroar
# Optional if URI path is empty or you want a different logical DB name:
# MONGODB_DATABASE=backroar

# --- Redis (recommended for production-like behavior) ---
# POS billing carts, stock-transfer drafts, and staff sessions persist in Redis when USE_REDIS=true.
# With USE_REDIS=false, the API uses in-memory storage (sessions reset on API restart).
# Product/variant gallery uploads always use direct Cloudinary in the API (no Redis/BullMQ for images).
USE_REDIS=false
# When USE_REDIS=true, set a reachable URL:
# REDIS_URL=redis://127.0.0.1:6379

API_HOST=0.0.0.0
API_PORT=3001
SESSION_COOKIE_NAME=br_session

# Required: >= 32 chars. Example: openssl rand -hex 32
SESSION_SECRET=replace_with_64_hex_chars_minimum_thirty_two__________

# JWT access + refresh (HS256). Omit JWT_SECRET to reuse SESSION_SECRET.
# JWT_SECRET=
# JWT_ACCESS_TTL_SEC=900
# JWT_REFRESH_TTL_SEC=604800

# React dev server origin (CORS + cookies). Must match the URL you use in the browser exactly
# (e.g. do not mix http://localhost:5173 and http://127.0.0.1:5173 — cookies are not shared across those hosts).
WEB_ORIGIN=http://localhost:5173

TRUST_PROXY=false
# COOKIE_SECURE=true

# Cloudinary (from dashboard; rotate keys if they were ever exposed)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PREFIX=backroar

# Prefix for auto-generated variant retail barcodes (Mongo TSPL/POS parity). Default B.
# BARCODE_PREFIX=B

NODE_ENV=development

# --- Web: point to PHP public assets for images not yet in Mongo (optional) ---
VITE_LEGACY_APP_URL=http://localhost:8000
